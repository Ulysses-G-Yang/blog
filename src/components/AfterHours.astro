---
/**
 * 「After Hours · 纸上微醺」特种纸夹页
 * 1px 细墨线 + 微暖米白纸底(#faf8f5),杂志插页质感。
 * 左半区:CREMA E BAFFI BAR 黑白镂空眼睛 Logo 线稿 + 酸甜烈爽四宫格缩略图
 * 右半区:调酒风味图谱(139 食材 · 114 酒谱 · 531 共现)+ 4 枚可点击风味切片胶囊
 */
interface Props {
  /** compact 用在 /projects 页,略微收窄留白 */
  compact?: boolean;
}

const CREMA_URL = 'https://ulysses-g-yang.github.io/crema-bar/';
const KB_URL = 'https://ulysses-g-yang.github.io/cocktail-kb-site/';

const flavors = [
  { label: '芒果 × 豆蔻', note: '热带 × 暖辛', query: '芒果,豆蔻' },
  { label: '番茄 × 小米辣', note: '鲜酸 × 火气', query: '番茄,小米辣' },
  { label: '威士忌 × 黄油洗', note: '谷物 × 脂香', query: '威士忌,黄油' },
  { label: '朗姆酒', note: '甘蔗 × 焦糖', query: '朗姆酒' },
] as const;

const grid = [
  { key: '酸', en: 'SOUR', d: 'M18 5 A13 13 0 1 0 18 31 A13 13 0 1 0 18 5 M18 5 V31 M5 18 H31 M9 9 L27 27 M27 9 L9 27' },
  { key: '甜', en: 'SWEET', d: 'M18 6 L30 12 V26 L18 32 L6 26 V12 Z M6 12 L18 18 L30 12 M18 18 V32' },
  { key: '烈', en: 'STRONG', d: 'M18 32 C10 25 12 13 18 4 C20 12 24 16 24 21 C26 19 27 16 26 13 C30 19 32 25 28 29 C26 32 22 33 18 32 Z' },
  { key: '爽', en: 'FRESH', d: 'M18 5 V31 M5 18 H31 M8 8 L28 28 M28 8 L8 28 M18 5 L14 8 M18 5 L22 8 M18 31 L14 28 M18 31 L22 28' },
] as const;

const { compact = false } = Astro.props;
---

<section
  class={`after-hours mx-auto max-w-5xl px-5 ${compact ? 'pb-16' : 'pb-24'}`}
  data-reveal
>
  <div class="relative border border-[#1c1b18]/25 bg-[#faf8f5]">
    <!-- 页眉:杂志夹页编号 -->
    <div
      class="flex items-center justify-between border-b border-[#1c1b18]/15 px-5 py-2.5"
    >
      <span class="label-mono text-[#8a8378]">After Hours · 纸上微醺</span>
      <span class="font-mono text-[10px] tracking-[0.2em] text-[#8a8378]"
        >INSET No.01 / 成都</span
      >
    </div>

    <div class="grid gap-0 md:grid-cols-2">
      <!-- 左半区:CREMA E BAFFI BAR -->
      <a
        href={CREMA_URL}
        target="_blank"
        rel="noopener"
        class="group flex flex-col justify-between border-b border-[#1c1b18]/15 px-5 py-7 transition-colors duration-150 hover:bg-[#f3efe6] md:border-r md:border-b-0"
      >
        <div>
          <span class="label-mono text-[#b3362d]">Crema e Baffi · 红星路</span>
          <div class="mt-4 flex items-center gap-4">
            <!-- 黑白镂空眼睛 Logo 线稿 -->
            <svg
              viewBox="0 0 120 56"
              class="h-12 w-24 shrink-0 text-[#1c1b18]"
              aria-hidden="true"
            >
              <path
                d="M8 30 C20 12 42 12 54 30 C42 48 20 48 8 30 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <circle cx="31" cy="30" r="6" fill="currentColor" />
              <path
                d="M66 30 C78 12 100 12 112 30 C100 48 78 48 66 30 Z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              />
              <circle cx="89" cy="30" r="6" fill="currentColor" />
              <path
                d="M8 30 L2 24 M12 20 L8 13 M54 30 L60 24 M50 20 L54 13"
                fill="none"
                stroke="currentColor"
                stroke-width="1.2"
              />
              <path
                d="M31 44 C26 52 20 50 18 46 M89 44 C94 52 100 50 102 46"
                fill="none"
                stroke="currentColor"
                stroke-width="1.1"
              />
            </svg>
            <div class="min-w-0">
              <h2
                class="text-lg leading-tight font-black tracking-tight text-[#1c1b18] uppercase"
              >
                Crema e Baffi Bar
              </h2>
              <p class="mt-1 text-sm leading-relaxed text-[#6f6960]">
                奶油胡子——成都红星路一间朋友的清吧。菜单不长,但每一杯都有出处。
              </p>
            </div>
          </div>
        </div>

        <!-- 酸甜烈爽四宫格缩略图 -->
        <div class="mt-6 grid grid-cols-4 gap-2">
          {
            grid.map((g) => (
              <div class="border border-[#1c1b18]/20 bg-white/70 px-2 py-2 text-center">
                <svg
                  viewBox="0 0 36 36"
                  class="mx-auto h-8 w-8 text-[#1c1b18]"
                  aria-hidden="true"
                >
                  <path
                    d={g.d}
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                  />
                </svg>
                <p class="mt-1 text-[13px] leading-none font-semibold text-[#1c1b18]">
                  {g.key}
                </p>
                <p class="mt-0.5 font-mono text-[9px] tracking-[0.18em] text-[#9a9286]">
                  {g.en}
                </p>
              </div>
            ))
          }
        </div>

        <p class="mt-5 label-mono text-[#8a8378] transition-colors group-hover:text-[#b3362d]">
          去店里看看 ↗
        </p>
      </a>

      <!-- 右半区:调酒风味图谱 -->
      <div class="flex flex-col justify-between px-5 py-7">
        <div>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <span class="label-mono text-[#b3362d]">Flavor Atlas</span>
            <span class="font-mono text-[11px] tracking-tight text-[#8a8378]">
              139 食材 · 114 酒谱 · 531 共现
            </span>
          </div>
          <h2
            class="mt-4 text-lg leading-tight font-black tracking-tight text-[#1c1b18]"
          >
            调酒风味图谱
          </h2>
          <p class="mt-1 text-sm leading-relaxed text-[#6f6960]">
            手稿印刷风的静态知识库:食材共现、分子共香与酒谱命中在同一屏里即时重算。
            选一枚风味切片,直接带着配方跳进去。
          </p>
        </div>

        <div class="mt-6 flex flex-wrap gap-2">
          {
            flavors.map((f) => (
              <a
                href={`${KB_URL}?selected=${encodeURIComponent(f.query)}`}
                target="_blank"
                rel="noopener"
                class="group inline-flex items-baseline gap-2 border border-[#1c1b18]/30 bg-white px-3 py-1.5 transition-colors duration-150 hover:border-[#b3362d]"
              >
                <span class="text-[13px] font-medium text-[#1c1b18] group-hover:text-[#b3362d]">
                  {f.label}
                </span>
                <span class="font-mono text-[9px] tracking-[0.12em] text-[#9a9286]">
                  {f.note}
                </span>
              </a>
            ))
          }
        </div>

        <a
          href={KB_URL}
          target="_blank"
          rel="noopener"
          class="mt-5 label-mono text-[#8a8378] transition-colors hover:text-[#b3362d]"
        >
          打开完整图谱 ↗
        </a>
      </div>
    </div>
  </div>
</section>
