---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, groupByYear, withBase } from '../utils/posts';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const groups = groupByYear(posts);
---

<BaseLayout title="归档" description="按时间线归档的全部文章">
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-16" data-hero>
    <p class="font-mono text-sm text-accent">// archive</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight">归档</h1>
    <p class="mt-4 text-muted">
      目前共计 {posts.length} 篇文章,时间是最诚实的记录者。
    </p>
  </section>

  <section class="mx-auto max-w-3xl space-y-12 px-5 pb-24">
    {
      groups.map(([year, yearPosts]) => (
        <div class="relative ml-2 border-l border-border pl-6" data-reveal>
          <div class="absolute top-1 -left-[7px] h-3.5 w-3.5 rounded-full border-2 border-accent bg-bg" />
          <h2 class="font-mono text-xl font-bold">{year}</h2>
          <ul class="mt-5 space-y-5">
            {yearPosts.map((post) => (
              <li class="group">
                <a
                  href={withBase(`/blog/${post.id}/`)}
                  class="flex flex-wrap items-baseline gap-x-4 gap-y-1"
                >
                  <time
                    datetime={post.data.pubDate.toISOString()}
                    class="font-mono text-xs text-muted"
                  >
                    {formatDate(post.data.pubDate)}
                  </time>
                  <span class="font-medium transition-colors group-hover:text-accent">
                    {post.data.title}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>
</BaseLayout>
