---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
import { SITE } from '../config';
import { REPOS } from '../data/repos';
import { withBase } from '../utils/posts';
---

<BaseLayout title="项目" description={`${SITE.author} 的项目展示`}>
  <section class="mx-auto max-w-5xl px-5 pt-16 pb-16" data-hero>
    <p class="label-mono text-accent">// projects</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight">项目</h1>
    <p class="mt-4 max-w-xl leading-relaxed text-muted">
      做过的一些东西:完整的、玩票的、半途而废的,挑能见人的放这里。
    </p>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="grid gap-4 md:grid-cols-2">
      {
        PROJECTS.map((project) => (
          <article
            data-reveal
            class="group flex flex-col rounded-2xl border border-border bg-surface p-6 transition-all duration-300 hover:-translate-y-1 hover:border-accent/60"
          >
            {
              project.image && (
                <div class="-mx-6 -mt-6 mb-4 overflow-hidden rounded-t-2xl border-b border-border">
                  <img
                    src={withBase(project.image)}
                    alt={`${project.name} 配图`}
                    loading="lazy"
                    class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                  />
                </div>
              )
            }

            <div class="flex items-center justify-between gap-3">
              <h2 class="text-lg font-bold transition-colors group-hover:text-accent">
                {project.name}
              </h2>
              {project.status && (
                <span class="shrink-0 rounded-full border border-border px-2.5 py-0.5 font-mono text-[11px] text-muted">
                  {project.status}
                </span>
              )}
            </div>

            <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">
              {project.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="rounded-full bg-bg-soft px-2.5 py-0.5 font-mono text-[11px] text-muted">
                  {tech}
                </span>
              ))}
            </div>

            <div class="mt-5 flex items-center gap-4 border-t border-border pt-4 text-xs">
              {project.link && (
                <a
                  href={project.link}
                  target="_blank"
                  rel="noopener"
                  class="label-mono text-muted transition-colors hover:text-accent"
                >
                  访问 ↗
                </a>
              )}
              {project.repo && (
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener"
                  class="label-mono text-muted transition-colors hover:text-accent"
                >
                  源码 ↗
                </a>
              )}
              {project.year && (
                <span class="ml-auto font-mono text-muted opacity-70">
                  {project.year}
                </span>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <!-- 全部开源仓库:诚实版,包括 fork 与一眼失败品的练手作 -->
    <section class="mt-20" data-reveal>
      <div class="flex items-baseline justify-between">
        <h2 class="text-2xl font-bold">全部开源仓库</h2>
        <span class="label-mono text-muted">{REPOS.length} 个 · 含 fork 与练手作,不装</span>
      </div>
      <ul class="mt-6 divide-y divide-border overflow-hidden rounded-2xl border border-border bg-surface">
        {
          REPOS.map((repo) => (
            <li>
              <a
                href={repo.url}
                target="_blank"
                rel="noopener"
                class="group flex items-start gap-4 p-4 transition-colors hover:bg-bg-soft sm:px-5 sm:py-4"
              >
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                    <span class="font-mono text-sm font-bold transition-colors group-hover:text-accent">
                      {repo.name}
                    </span>
                    {repo.upstream && (
                      <span class="rounded-full border border-border px-2 py-0.5 font-mono text-[10px] text-muted">
                        fork · {repo.upstream}
                      </span>
                    )}
                    <time class="font-mono text-[11px] text-muted opacity-70">
                      {repo.lastPush}
                    </time>
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">
                    {repo.desc}
                  </span>
                  <span class="mt-1 block text-xs text-muted opacity-80">
                    {repo.note}
                  </span>
                </span>
                <span class="hidden shrink-0 text-muted transition-transform group-hover:translate-x-1 sm:block">
                  →
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-10 text-center text-sm text-muted" data-reveal>
      更多折腾记录散落在
      <a
        href="https://github.com/Ulysses-G-Yang"
        target="_blank"
        rel="noopener"
        class="text-accent hover:underline">GitHub</a
      > 里。
    </p>
  </section>
</BaseLayout>
