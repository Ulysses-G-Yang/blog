---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import TagPill from '../../components/TagPill.astro';
import TOC from '../../components/TOC.astro';
import PrevNext from '../../components/PrevNext.astro';
import Giscus from '../../components/Giscus.astro';
import { BASE, categoryLabel, readingMinutes, sortPostsDesc, withBase } from '../../utils/posts';
import { SITE } from '../../config';
import PostTools from '../../components/PostTools.astro';


export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 上一篇 = 时间上更早的;下一篇 = 时间上更新的
const sorted = sortPostsDesc(
  await getCollection('blog', ({ data }) => !data.draft),
);
const index = sorted.findIndex((p) => p.id === post.id);
const prev = index < sorted.length - 1 ? sorted[index + 1] : undefined;
const next = index > 0 ? sorted[index - 1] : undefined;

// 每篇文章的专属 OG 分享图(构建时由 satori 生成)
const ogImage = new URL(`${BASE}og/${post.id}.png`, SITE.url).href;

// 结构化数据(SEO/GEO):文章 + 面包屑
const publishedISO = post.data.pubDate.toISOString();
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: publishedISO,
    ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
    author: { '@type': 'Person', name: SITE.author, url: SITE.github },
    publisher: { '@type': 'Person', name: SITE.author },
    image: ogImage,
    keywords: post.data.tags.join(', '),
    articleSection: categoryLabel(post.data.category),
    inLanguage: 'zh-CN',
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
    url: pageUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: '博客', item: `${SITE.url}/blog/` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  headerTitle={post.data.title}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <ReadingProgress />
  <article data-pagefind-body class="mx-auto max-w-5xl px-5 pt-14 pb-24">
    <header class="max-w-3xl" data-hero>
      {
        post.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <TagPill tag={tag} />
            ))}
          </div>
        )
      }
      {
        post.data.series && (
          <p class="label-mono mt-3 text-accent">
            系列 · {post.data.series}
            {post.data.seriesOrder !== undefined && ` · 第 ${post.data.seriesOrder} 篇`}
            <a
              href={withBase('/series/')}
              class="ml-1 text-muted transition-colors hover:text-accent"
            >
              (系列目录)
            </a>
          </p>
        )
      }
      <h1
        class="mt-4 text-3xl leading-tight font-black tracking-tight sm:text-4xl"
      >
        {post.data.title}
      </h1>
      <div
        class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted"
      >
        <FormattedDate date={post.data.pubDate} />
        <span aria-hidden="true">·</span>
        <span>约 {readingMinutes(post.body)} 分钟</span>
        {
          post.data.updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                更新于
                <FormattedDate date={post.data.updatedDate} />
              </span>
            </>
          )
        }
      </div>
    </header>

    <div class="mt-12 flex gap-12">
      <div class="min-w-0 max-w-3xl flex-1">
        <div class="prose prose-blog max-w-none">
          <Content />
        </div>
        <PrevNext
          prev={prev && {
            title: prev.data.title,
            href: withBase(`/blog/${prev.id}/`),
          }}
          next={next && {
            title: next.data.title,
            href: withBase(`/blog/${next.id}/`),
          }}
        />
        <Giscus />
      </div>
      <TOC headings={toc} />
    </div>
  </article>

  <!-- 悬浮工具:目录抽屉 + 回顶部(移动端/平板目录缺口补齐) -->
  <PostTools headings={toc} />
</BaseLayout>
