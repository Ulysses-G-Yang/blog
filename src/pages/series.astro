---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categoryLabel, formatDate } from '../utils/posts';
import type { Post } from '../utils/posts';

const posts = await getCollection('blog', ({ data }) => !data.draft && data.series);

// 系列名 → 按序号排列的文章
const groups = new Map<string, Post[]>();
for (const post of posts) {
  const name = post.data.series!;
  const list = groups.get(name) ?? [];
  list.push(post);
  groups.set(name, list);
}
const series = [...groups.entries()]
  .map(([name, list]) => ({
    name,
    posts: list.sort(
      (a, b) => (a.data.seriesOrder ?? 99) - (b.data.seriesOrder ?? 99),
    ),
  }))
  .sort((a, b) => b.posts.length - a.posts.length);
---

<BaseLayout title="系列专栏" description="成系列的文章合集,一次看个痛快">
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-24">
    <div data-hero>
      <p class="label-mono text-accent">// series</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight">系列专栏</h1>
      <p class="mt-5 leading-relaxed text-muted">
        成系列的长文合集,按顺序读体验最佳。
      </p>
    </div>

    <div class="mt-12 space-y-12">
      {
        series.map(({ name, posts: list }) => (
          <section data-reveal>
            <div class="flex items-baseline justify-between">
              <h2 class="text-2xl font-black">{name}</h2>
              <span class="label-mono text-muted">{list.length} 篇</span>
            </div>
            <ol class="mt-6 space-y-3">
              {list.map((post, i) => (
                <li>
                  <a
                    href={`/blog/${post.id}/`}
                    class="group flex items-center gap-4 rounded-2xl border border-border bg-surface p-5 transition-all duration-300 hover:-translate-y-0.5 hover:border-accent/50"
                  >
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-accent/60 font-mono text-sm font-bold text-accent">
                      {(post.data.seriesOrder ?? i + 1).toString()}
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block truncate font-semibold transition-colors group-hover:text-accent">
                        {post.data.title}
                      </span>
                      <span class="mt-0.5 block font-mono text-xs text-muted">
                        {formatDate(post.data.pubDate)} · {categoryLabel(post.data.category)}
                      </span>
                    </span>
                    <span class="hidden text-muted transition-transform group-hover:translate-x-1 sm:block">
                      →
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      {
        series.length === 0 && (
          <p class="py-16 text-center text-muted">还没有成系列的文章,敬请期待。</p>
        )
      }
    </div>
  </section>
</BaseLayout>
