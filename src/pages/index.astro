---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroCanvas from '../components/HeroCanvas.astro';
import PostCard from '../components/PostCard.astro';
import TagPill from '../components/TagPill.astro';
import Timeline from '../components/Timeline.astro';
import { SITE } from '../config';
import { getAllTags, sortPostsDesc, withBase } from '../utils/posts';

const posts = sortPostsDesc(
  await getCollection('blog', ({ data }) => !data.draft),
);
const latest = posts.slice(0, 4);
const tags = getAllTags(posts);
const latestNotes = sortPostsDesc(
  await getCollection('notes', ({ data }) => !data.draft),
).slice(0, 3);

/** 去掉 Markdown 符号,取纯文本摘要 */
const plainText = (s: string, n = 90): string =>
  s.replace(/[#>*`\n]/g, ' ').slice(0, n);
---

<BaseLayout>
  <!-- Hero:大号双色标题(参考 Code Barcelona 的排版骨架) -->
  <section class="relative mx-auto max-w-5xl px-5 pt-20 pb-16 sm:pt-28" data-hero>
    <HeroCanvas />
    <p class="label-mono text-accent">
      // WEB DEVELOPER & WRITER — $ whoami
    </p>
    <h1
      class="mt-6 text-5xl leading-[1.05] font-black tracking-tight uppercase sm:text-7xl"
    >
      你好,我是<br />
      <span class="text-accent">{SITE.author}</span>
    </h1>
    <p class="mt-7 max-w-xl leading-relaxed text-muted">
      在这里记录前端、工程化与一切让我着迷的技术。相信「写下来」是最好的思考方式,也是最快的成长路径。
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href={withBase('/blog/')} class="btn-primary">Start Reading →</a>
      <a href={withBase('/about/')} class="btn-ghost">About Me</a>
    </div>
  </section>

  <!-- 双跑马灯:上行正向、下行反向;滚动越快滑得越快(悬停暂停) -->
  <div class="border-y border-border" aria-hidden="true">
    <div class="marquee py-5">
      <div class="marquee-track" data-marquee-dir="1">
        <span
          class="pr-8 text-6xl font-black tracking-tight whitespace-nowrap text-accent uppercase sm:text-7xl"
        >
          Write · Build · Share · 写代码 · 写文章 · 保持好奇 ·
        </span>
        <span
          class="pr-8 text-6xl font-black tracking-tight whitespace-nowrap text-accent uppercase sm:text-7xl"
        >
          Write · Build · Share · 写代码 · 写文章 · 保持好奇 ·
        </span>
      </div>
    </div>
    <div class="marquee border-t border-border/60 py-4">
      <div class="marquee-track marquee-rev">
        <span
          class="pr-8 text-5xl font-black tracking-tight whitespace-nowrap text-text/20 uppercase sm:text-6xl"
        >
          Frontend · Engineering · 前端 · 工程化 · 折腾不止 ·
        </span>
        <span
          class="pr-8 text-5xl font-black tracking-tight whitespace-nowrap text-text/20 uppercase sm:text-6xl"
        >
          Frontend · Engineering · 前端 · 工程化 · 折腾不止 ·
        </span>
      </div>
    </div>
  </div>

  <!-- 大数字统计带 -->
  <section class="mx-auto max-w-5xl px-5 py-14" data-reveal>
    <div class="grid grid-cols-3 gap-6">
      <div>
        <p class="label-mono text-muted">Posts</p>
        <p class="mt-3 text-4xl font-black sm:text-5xl">
          {posts.length}<span class="text-accent">+</span>
        </p>
        <p class="mt-2 text-sm text-muted">篇文章</p>
      </div>
      <div>
        <p class="label-mono text-muted">Tags</p>
        <p class="mt-3 text-4xl font-black sm:text-5xl">
          {tags.length}<span class="text-accent">+</span>
        </p>
        <p class="mt-2 text-sm text-muted">个标签</p>
      </div>
      <div>
        <p class="label-mono text-muted">Since</p>
        <p class="mt-3 text-4xl font-black sm:text-5xl">2026</p>
        <p class="mt-2 text-sm text-muted">持续更新中</p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="flex items-end justify-between" data-reveal>
      <h2 class="text-2xl font-bold">最新文章</h2>
      <a
        href={withBase('/blog/')}
        class="label-mono text-muted transition-colors hover:text-accent"
      >
        全部文章 →
      </a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {latest.map((post) => <PostCard post={post} />)}
    </div>

    <!-- 本周折腾:短内容流 -->
    {
      latestNotes.length > 0 && (
        <div class="mt-16" data-reveal>
          <div class="flex items-end justify-between">
            <h2 class="text-2xl font-bold">本周折腾</h2>
            <a
              href={withBase('/notes/')}
              class="label-mono text-muted transition-colors hover:text-accent"
            >
              全部折腾 →
            </a>
          </div>
          <div class="mt-6 grid gap-4 sm:grid-cols-3">
            {latestNotes.map((note) => (
              <a
                href={withBase('/notes/')}
                class="group block rounded-2xl border border-border bg-surface p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/50"
              >
                <div class="flex items-center gap-3">
                  <time
                    datetime={note.data.pubDate.toISOString()}
                    class="label-mono text-muted"
                  >
                    {note.data.pubDate.toLocaleDateString('zh-CN')}
                  </time>
                  {note.data.mood && (
                    <span class="text-xs text-accent">{note.data.mood}</span>
                  )}
                </div>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
                  {plainText(note.body ?? '')}
                </p>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- 时间线:年 → 月 折叠式梳理 -->
    {posts.length > 0 && (
      <div class="mt-16">
        <Timeline posts={posts} />
      </div>
    )}

    {
      tags.length > 0 && (
        <div class="mt-16" data-reveal>
          <h2 class="text-2xl font-bold">标签云</h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.slice(0, 10).map(({ tag, count }) => (
              <TagPill tag={tag} count={count} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
