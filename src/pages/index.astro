---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import TagPill from '../components/TagPill.astro';
import { SITE } from '../config';
import { getAllTags, sortPostsDesc, withBase } from '../utils/posts';

const posts = sortPostsDesc(
  await getCollection('blog', ({ data }) => !data.draft),
);
const latest = posts.slice(0, 4);
const tags = getAllTags(posts).slice(0, 10);
---

<BaseLayout>
  <section
    class="relative mx-auto max-w-5xl px-5 pt-16 pb-20 sm:pt-24"
    data-hero
  >
    <p class="font-mono text-sm text-accent">$ whoami</p>
    <h1 class="mt-4 text-4xl leading-tight font-black tracking-tight sm:text-6xl">
      你好,我是<br class="sm:hidden" />
      <span class="text-gradient">{SITE.author}</span>
    </h1>
    <p class="mt-6 max-w-xl leading-relaxed text-muted">
      在这里记录前端、工程化与一切让我着迷的技术。相信「写下来」是最好的思考方式,也是最快的成长路径。
    </p>
    <div class="mt-9 flex flex-wrap gap-3">
      <a href={withBase('/blog/')} class="btn-primary">开始阅读 →</a>
      <a href={withBase('/about/')} class="btn-ghost">关于我</a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-5 pb-24">
    <div class="flex items-end justify-between" data-reveal>
      <h2 class="text-2xl font-bold">最新文章</h2>
      <a
        href={withBase('/blog/')}
        class="text-sm text-muted transition-colors hover:text-accent"
      >
        全部文章 →
      </a>
    </div>
    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      {latest.map((post) => <PostCard post={post} />)}
    </div>

    {
      tags.length > 0 && (
        <div class="mt-16" data-reveal>
          <h2 class="text-2xl font-bold">标签云</h2>
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.map(({ tag, count }) => (
              <TagPill tag={tag} count={count} />
            ))}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
