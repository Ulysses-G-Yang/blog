---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { sortPostsDesc } from '../../utils/posts';
import type { CollectionEntry } from 'astro:content';

type Note = CollectionEntry<'notes'>;
const notes = (
  await getCollection('notes', ({ data }) => !data.draft)
).sort((a: Note, b: Note) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const rendered = await Promise.all(
  notes.map(async (note) => ({ note, Content: (await render(note)).Content })),
);
---

<BaseLayout title="本周折腾" description="微博式短内容:最近的折腾、踩坑与碎碎念">
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-24">
    <div data-hero>
      <p class="label-mono text-accent">// notes</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight">本周折腾</h1>
      <p class="mt-5 leading-relaxed text-muted">
        来不及写成长文的,都以小记的形式堆在这里。短,但都是真的。
      </p>
    </div>

    <div class="mt-12 space-y-10">
      {
        rendered.map(({ note, Content }) => (
          <article
            data-reveal
            class="rounded-2xl border border-border bg-surface p-6 transition-colors hover:border-accent/40"
          >
            <div class="flex items-center gap-3">
              <time
                datetime={note.data.pubDate.toISOString()}
                class="label-mono text-muted"
              >
                {note.data.pubDate.toLocaleDateString('zh-CN')}
              </time>
              {note.data.mood && (
                <span class="text-sm text-accent">{note.data.mood}</span>
              )}
            </div>
            <div class="prose prose-blog mt-4 max-w-none text-[15px]">
              <Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
