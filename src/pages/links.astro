---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FRIENDS } from '../data/friends';
---

<BaseLayout title="友链" description="朋友们的地方">
  <section class="mx-auto max-w-3xl px-5 pt-16 pb-24">
    <div data-hero>
      <p class="label-mono text-accent">// friends</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight">友链</h1>
      <p class="mt-5 leading-relaxed text-muted">
        朋友们的地方。想交换友链:在
        <a href="/blog/guestbook/" class="text-accent hover:underline">留言板</a>
        留言,或直接提 PR 改
        <code class="font-mono text-sm">src/data/friends.ts</code>,
        附上站点名、链接和一句话介绍。
      </p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2" data-reveal>
      {
        FRIENDS.map((friend) => (
          <a
            href={friend.url}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-4 rounded-2xl border border-border bg-surface p-5 transition-all duration-300 hover:-translate-y-1 hover:border-accent/60"
          >
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-bg-soft text-lg font-black text-accent">
              {friend.mark ?? friend.name.slice(0, 1).toUpperCase()}
            </span>
            <span class="min-w-0">
              <span class="block font-semibold transition-colors group-hover:text-accent">
                {friend.name}
              </span>
              <span class="mt-0.5 block truncate text-sm text-muted">
                {friend.desc}
              </span>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
